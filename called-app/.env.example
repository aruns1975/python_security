# Called application (port 48081). Generate real values with: python3 scripts/generate_credentials.py
# Values below are placeholders. Never commit a real .env.

# Server-side pepper for HMAC-SHA256 key hashing (>= 32 bytes). Keep in a secrets manager in production.
SECURITY_INBOUND_API_KEY_PEPPER=<random-pepper-at-least-32-bytes>

# Accepted API keys, stored as HMAC-SHA256(pepper, key) hex digests. Never raw keys.
SECURITY_INBOUND_API_KEYS='[{"key_id":"mycaller-app","key_hash":"<64-hex-hmac-sha256>","subject":"svc:mycaller-app","authorities":["ORDER_READ"]}]'

# Optional (defaults shown):
# SECURITY_INBOUND_API_KEY_HEADER=X-API-Key
# SECURITY_INBOUND_PUBLIC_PATHS='["/health", "/docs", "/docs/oauth2-redirect", "/redoc", "/openapi.json"]'
