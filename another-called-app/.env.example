# Another Called application (port 38081). Generate real values with: python3 scripts/generate_credentials.py
# Values below are placeholders. Never commit a real .env.

# Server-side pepper for HMAC-SHA256 secret hashing (>= 32 bytes). Keep in a secrets manager in production.
SECURITY_INBOUND_APP_CREDENTIALS_PEPPER=<random-pepper-at-least-32-bytes>

# Registered applications: secret keys stored as HMAC-SHA256(pepper, application_id + NUL + secret) hex digests. Never raw secrets.
SECURITY_INBOUND_APP_CREDENTIALS='[{"application_id":"<application-id>","secret_hash":"<64-hex-hmac-sha256>","subject":"svc:mycaller-app","authorities":["INVENTORY_READ"]}]'

# Optional (defaults shown):
# SECURITY_INBOUND_APPLICATION_ID_HEADER=X-Application-Id
# SECURITY_INBOUND_SECRET_KEY_HEADER=X-Secret-Key
# SECURITY_INBOUND_PUBLIC_PATHS='["/health", "/docs", "/docs/oauth2-redirect", "/redoc", "/openapi.json"]'
