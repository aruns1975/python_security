# MyCaller application (port 58081). Generate real values with: python3 scripts/generate_credentials.py
# Values below are placeholders. Never commit a real .env.

# ---- Inbound: API keys of MyCaller's own clients ----
SECURITY_INBOUND_API_KEY_PEPPER=<random-pepper-at-least-32-bytes>
SECURITY_INBOUND_API_KEYS='[{"key_id":"dashboard-client","key_hash":"<64-hex-hmac-sha256>","subject":"client:dashboard","authorities":["ORDER_READ","INVENTORY_READ","DASHBOARD_READ"]},{"key_id":"orders-client","key_hash":"<64-hex-hmac-sha256>","subject":"client:orders","authorities":["ORDER_READ"]}]'

# ---- Outbound: service registry (secret references only) ----
# LOCAL DEVELOPMENT ONLY: allow_insecure_http=true permits plain http to localhost.
# Production MUST use https base URLs and omit allow_insecure_http (ServiceConfig rejects http otherwise).
SECURITY_OUTBOUND_SERVICES='{"CALLED_APP":{"service_id":"CALLED_APP","base_url":"http://127.0.0.1:48081","auth_type":"API_KEY","credential_ref":"called-app","allow_insecure_http":true},"ANOTHER_CALLED_APP":{"service_id":"ANOTHER_CALLED_APP","base_url":"http://127.0.0.1:38081","auth_type":"APP_CREDENTIALS","credential_ref":"another-called-app","allow_insecure_http":true}}'

# ---- Outbound secrets (EnvSecretStore: OUTBOUND_<CREDENTIAL_REF>__<KEY>) ----
# Must be the raw values whose hashes the called apps store.
OUTBOUND_CALLED_APP__API_KEY=<raw-api-key-for-called-app>
OUTBOUND_ANOTHER_CALLED_APP__APPLICATION_ID=<application-id>
OUTBOUND_ANOTHER_CALLED_APP__SECRET_KEY=<raw-secret-key-for-another-called-app>
